# All settings are optional. Copy to .env to use.
LITSCOUT_DB_PATH=data/litscout.db
# Require a password for the web UI (recommended if serving beyond localhost)
LITSCOUT_ACCESS_PASSWORD=
# Signs the login cookie; generate with: python -c "import secrets; print(secrets.token_hex(32))"
LITSCOUT_SECRET_KEY=
LITSCOUT_SOURCES_ENABLED=openalex,arxiv,crossref,demo
# Your email, sent to OpenAlex and Crossref for their faster "polite pool" (optional)
LITSCOUT_CONTACT_EMAIL=

# Optional LLM synthesis. Without these, the offline extractive drafter is used.
# LITSCOUT_LLM_PROVIDER=anthropic   # or: openai (any OpenAI-compatible server, e.g. Ollama)
# LITSCOUT_LLM_API_KEY=
# LITSCOUT_LLM_MODEL=
# LITSCOUT_LLM_BASE_URL=http://localhost:11434/v1
